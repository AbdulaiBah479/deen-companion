// Writes a small layout.tsx next to each page listed in src/lib/seo.ts, giving that page its own title, description, canonical address,
// social-sharing tags and breadcrumb data in the HTML the server sends. Run: npm run gen:seo   (safe to run again)
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { PAGES } from '../src/lib/seo.ts'

// Sections that have pages below them (a surah, a story…): those pages add their own breadcrumb, so the section layout must not add one.
const HAS_CHILDREN = new Set(['/quran', '/stories', '/heritage', '/learn', '/tafsir', '/books', '/library', '/reels'])
let made = 0
for (const path of Object.keys(PAGES)) {
  const dir = new URL(`../src/app/(app)${path}/`, import.meta.url)
  if (!existsSync(new URL('page.tsx', dir))) continue
  const parts = path.split('/').filter(Boolean)
  const leaf = !HAS_CHILDREN.has(path)
  const body = leaf ? `// Generated by scripts/gen-seo-layouts.mts from src/lib/seo.ts. Edit the text there, then run npm run gen:seo.
import JsonLd from '@/components/JsonLd'
import { PAGES, breadcrumbLd, pageMetadata } from '@/lib/seo'

export const metadata = pageMetadata('${path}')

export default function Layout({ children }: { children: React.ReactNode }) {
  return (
    <>
      <JsonLd data={breadcrumbLd([{ name: 'Home', path: '/' }, ${parts.length > 1 ? `{ name: 'More', path: '/more' }, ` : ''}{ name: PAGES['${path}'].title, path: '${path}' }])} />
      {children}
    </>
  )
}
` : `// Generated by scripts/gen-seo-layouts.mts from src/lib/seo.ts. Edit the text there, then run npm run gen:seo.
import { pageMetadata } from '@/lib/seo'

export const metadata = pageMetadata('${path}')

export default function Layout({ children }: { children: React.ReactNode }) {
  return children
}
`
  const file = new URL('layout.tsx', dir)
  if (existsSync(file) && !readFileSync(file, 'utf8').startsWith('// Generated by scripts/gen-seo-layouts')) {
    console.log('SKIP (hand-written layout exists):', path)
    continue
  }
  writeFileSync(file, body)
  made++
}
console.log('wrote', made, 'layouts')
