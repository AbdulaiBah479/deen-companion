# Copy this file to .env.local and fill in what you have. Everything is optional: the app works without any
# keys (Quran, hadith, prayer times, search, quiz, games, etc.). Keys unlock the AI features and cloud sync.

# ── AI companion (free tiers) ────────────────────────────────────────────────
# Set any of these; providers are tried in this order: Gemini, Groq, Mistral, Cerebras, GitHub Models, SambaNova, NVIDIA, Hugging Face, OpenRouter, Cloudflare, Pollinations (opt-in), Custom.
# Free-tier limits change often — check each provider's current pricing page.
GEMINI_API_KEY=            # https://aistudio.google.com  (model override: GEMINI_MODEL)
GROQ_API_KEY=              # https://console.groq.com     (model override: GROQ_MODEL) — also powers audio transcription
MISTRAL_API_KEY=           # https://console.mistral.ai   (model override: MISTRAL_MODEL)
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai    (requires CEREBRAS_MODEL too)
CEREBRAS_MODEL=
OPENROUTER_API_KEY=        # https://openrouter.ai — a free model is picked automatically (override: OPENROUTER_MODEL)
CLOUDFLARE_ACCOUNT_ID=     # Workers AI
CLOUDFLARE_AI_KEY=
# More free services (each one is another independent quota to fall back on):
GITHUB_MODELS_TOKEN=       # a GitHub personal access token (no scopes needed) — https://github.com/marketplace/models  (GITHUB_MODELS_MODEL)
SAMBANOVA_API_KEY=         # https://cloud.sambanova.ai   (SAMBANOVA_MODEL)
NVIDIA_API_KEY=            # https://build.nvidia.com     (NVIDIA_MODEL)
HF_TOKEN=                  # https://huggingface.co/settings/tokens (HF_MODEL)
# MODEL variables accept a comma-separated list, tried in order, e.g. GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b (model names change over time: if answers stop, check the provider's model list)
# (every model has its own free limit, so listing several multiplies your free capacity — Gemini and Groq already try two).
# Keyless last resort: POLLINATIONS=on sends questions to text.pollinations.ai with no key and no agreement with them. Off by
# default because users' questions would leave your control; if you turn it on, say so in your privacy policy.
POLLINATIONS=
# Optional site-wide cap on AI answers per day (UTC). After it, users get sourced answers without a model call. 0/empty = no cap.
AI_DAILY_CALLS=
# Any OpenAI-compatible server — e.g. a FREE LOCAL model with Ollama (https://ollama.com):
#   ollama pull llama3.1   then   CUSTOM_AI_BASE_URL=http://localhost:11434/v1  CUSTOM_AI_MODEL=llama3.1
CUSTOM_AI_BASE_URL=
CUSTOM_AI_KEY=
CUSTOM_AI_MODEL=

# ── Quran Identifier: audio transcription (optional) ────────────────────────
# Defaults to Groq Whisper using GROQ_API_KEY. Live mic mode in Chrome/Edge needs no key.
STT_BASE_URL=
STT_KEY=
STT_MODEL=

# ── Lectures (optional) ──────────────────────────────────────────────────────
# Channels whose newest videos appear on /lectures (read from each channel's public YouTube RSS feed; no API key).
# Format: "Name|ChannelID, Name|ChannelID". A channel ID starts with UC (YouTube -> channel page -> About -> Share -> Copy channel ID).
# Left empty, the starter channels are used (Yaqeen Institute and Mufti Menk — verified IDs). Set LECTURE_CHANNELS=none to turn
# the page off. Choose teachers and institutions YOU trust; a channel is not a fatwa.
LECTURE_CHANNELS=

# ── Prayer reminders when the app is closed (optional; needs the Upstash Redis above) ─────────────
# Generate the keys with:  npm run vapid   (prints all four values). Keep VAPID_PRIVATE_KEY and CRON_SECRET secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=               # at least 16 characters; the scheduler sends it as "Authorization: Bearer …"

# ── Site address (for share previews and the sitemap) ────────────────────────
NEXT_PUBLIC_SITE_URL=      # e.g. https://deen.example.com

# ── Reels video backgrounds (optional) ───────────────────────────────────────
# Free key from https://www.pexels.com/api/ . Without it Reels use animated backgrounds. The key stays on the server.
# Pexels requires showing a link to Pexels and crediting the videographer; the Reels UI does both.
PEXELS_API_KEY=

# ── Cloud sync & accounts (Supabase) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DONATE_URL=    # shows a "Support Deen Companion" button on the Sadaqah page
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Control room (/admin) and the autopilot ──────────────────────────────────────────────────────────────────────────────
ADMIN_KEY=                 # a private phrase (12+ characters, longer is safer) only you know; opens /admin. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ALERT_WEBHOOK_URL=         # optional: a Discord/Slack-style webhook that also receives alerts (falls back to ERROR_WEBHOOK_URL)
# The autopilot is started by .github/workflows/watchdog.yml (needs the APP_URL and CRON_SECRET repository secrets).
# SUPABASE_SERVICE_ROLE_KEY (above) also lets the control room list and delete accounts.
