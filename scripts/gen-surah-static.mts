// Writes src/lib/surah-static.ts: the list of surahs (names, verse counts, page) and the juz index, copied from the app's own Quran data.
// The Quran page shows this at once, instead of waiting to download the same list after the page opens.
// Run: npm run gen:surahs
import { writeFileSync } from 'node:fs'
import { getSurahs, juzIndex, surahPages } from '../src/lib/data.ts'

const pages = surahPages()
const surahs = getSurahs().map((s, i) => ({ id: s.id, name_simple: s.name_simple, name_arabic: s.name_arabic, verses_count: s.verses_count, revelation_place: s.revelation_place, translated_name: { name: s.translated_name.name }, page: pages[i] }))
const juz = juzIndex()
writeFileSync(
  new URL('../src/lib/surah-static.ts', import.meta.url),
  `// Generated by scripts/gen-surah-static.mts from the app's Quran data. Do not edit by hand.\nimport type { JuzInfo, SurahInfo } from './surah-list'\nexport const STATIC_SURAHS: SurahInfo[] = ${JSON.stringify(surahs)}\nexport const STATIC_JUZ: JuzInfo[] = ${JSON.stringify(juz)}\n`
)
console.log('wrote', surahs.length, 'surahs and', juz.length, 'juz')
