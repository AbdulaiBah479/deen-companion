// Writes src/lib/route-ids.ts: the ids of every story, person, course, lesson and book. The server uses it to answer a made-up address
// (for example /stories/nope) with a real 404 before any page is built. A test checks that it matches the real lists.
// Run: npm run gen:ids
import { writeFileSync } from 'node:fs'
import { BOOKS } from '../src/lib/books.ts'
import { COURSES, STATIC_ALL, lessonIds } from '../src/lib/courses.ts'
import { HERITAGE } from '../src/lib/heritage.ts'
import { STORIES } from '../src/lib/stories.ts'

const lessons = Object.fromEntries(Object.entries(STATIC_ALL).map(([k, v]) => [k, v.map((l) => l.id)]))
const out = {
  stories: STORIES.map((s) => s.id),
  heritage: HERITAGE.map((h) => h.id),
  books: BOOKS.map((b) => b.id),
  courses: COURSES.map((c) => c.id),
  lessons, // only the courses whose lessons are written out (letters and Quran words are built from data and accept any id)
  fixedLessonCounts: { letters: lessonIds('letters').length, words: lessonIds('words').length },
}
writeFileSync(new URL('../src/lib/route-ids.ts', import.meta.url), `// Generated by scripts/gen-route-ids.mts. Do not edit by hand; run npm run gen:ids.\nexport const ROUTE_IDS = ${JSON.stringify(out, null, 1)} as const\n`)
console.log('stories', out.stories.length, 'people', out.heritage.length, 'books', out.books.length, 'courses', out.courses.length)
